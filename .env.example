# Copy to .env and fill in real values. Never commit .env.

MODE=mock                     # mock | live
SQLITE_DB_PATH=database/airfare_demo.db   # local/demo backend (stdlib sqlite3, no install needed)
FORECAST_CACHE_TTL_MINUTES=60             # how long /api/forecast results are cached before retraining
DATABASE_URL=postgresql://airfare_user:airfare_pass@postgres:5432/airfare_index  # production target (Docker/Postgres path, not yet wired to main.py)
POSTGRES_USER=airfare_user
POSTGRES_PASSWORD=airfare_pass
POSTGRES_DB=airfare_index

CORS_ORIGINS=http://localhost:3000

SCRAPE_INTERVAL_MINUTES=15
SCRAPE_MAX_RETRIES=3
SCRAPE_BACKOFF_BASE_SECONDS=5
DAILY_ROUTE_PAIRS=20
COMPAREFLIGHTS_SCRAPE_HOUR=6
COMPAREFLIGHTS_SCRAPE_MINUTE=0
IXIGO_SCRAPE_HOUR=6
IXIGO_SCRAPE_MINUTE=30

# DGCA route-basket refresh. The worker checks daily because the latest
# complete month may not be uploaded immediately on the 1st/2nd of a month.
DGCA_CHECK_HOUR=9
DGCA_CHECK_MINUTE=30
DGCA_TOP_N=50
DGCA_DIRECTION_MODE=bidirectional  # unidirectional | bidirectional | merged

REDIS_URL=redis://redis:6379/0   # only used if/when caching is enabled

LOG_LEVEL=INFO
